# Copy this file to `.env` and adjust as needed: cp .env.example .env

# ---- Postgres ----
POSTGRES_USER=exchange
POSTGRES_PASSWORD=exchange
POSTGRES_DB=exchange
POSTGRES_HOST_PORT=5432
# Base connection (admin db). Per-service databases are created on first init.
DATABASE_URL=postgres://exchange:exchange@localhost:5432/exchange
# Database-per-service (each service owns its own database/tables)
PORTFOLIO_DATABASE_URL=postgres://exchange:exchange@localhost:5432/portfolio
AUDIT_DATABASE_URL=postgres://exchange:exchange@localhost:5432/audit

# ---- Kafka ----
# Host-facing bootstrap (apps running on your machine connect here)
KAFKA_HOST_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# In-cluster bootstrap (other compose services connect here)
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092

# ---- Web UIs ----
KAFKA_UI_PORT=8080
ADMINER_PORT=8081
